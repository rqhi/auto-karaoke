<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    android:orientation="vertical">

    <!-- Top bar: wordmark + actions -->
    <LinearLayout
        android:id="@+id/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_extrabold"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/headlight"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btn_performance_mode"
            style="@style/Widget.AutoLyrics.TopAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Open full-screen karaoke"
            android:text="Sing"
            app:icon="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/btn_settings_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lyrics settings"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Notification access prompt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jakarta_medium"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/headlight"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_permission"
            style="@style/Widget.AutoLyrics.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="Allow notification access"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Now playing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/iv_album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_album_art"
            android:contentDescription="Album art"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_bold"
                android:maxLines="1"
                android:textColor="@color/headlight"
                android:textSize="17sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_medium"
                android:maxLines="1"
                android:textColor="@color/dusk"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_wrong_lyrics"
            style="@style/Widget.AutoLyrics.Chip.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:minHeight="36dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Wrong lyrics?"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Lyrics -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_lyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdgeLength="80dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="balanced"
                android:fontFamily="@font/jakarta_bold"
                android:gravity="start"
                android:lineSpacingMultiplier="1.12"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="200dp"
                android:text="Play a song in Spotify or any music app. The lyrics will show up here and on Android Auto."
                android:textColor="@color/headlight"
                android:textSize="20sp" />
        </ScrollView>

        <Button
            android:id="@+id/btn_jump_to_current"
            style="@style/Widget.AutoLyrics.Accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:elevation="6dp"
            android:text="Back to current line"
            android:visibility="gone" />

        <!-- Settings card (hidden until the gear is tapped) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_font_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_panel"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <!-- Lyrics -->
                <TextView
                    style="@style/AutoLyricsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lyrics" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AutoLyricsRowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Text size" />

                    <Button
                        android:id="@+id/btn_font_size_minus"
                        style="@style/Widget.AutoLyrics.Chip.Square"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Smaller text"
                        android:text="−" />

                    <TextView
                        android:id="@+id/tv_font_size"
                        style="@style/AutoLyricsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="56dp"
                        android:text="20" />

                    <Button
                        android:id="@+id/btn_font_size_plus"
                        style="@style/Widget.AutoLyrics.Chip.Square"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Bigger text"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    style="@style/AutoLyricsRowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Font" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_font_sans"
                        style="@style/Widget.AutoLyrics.Chip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_bold"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Jakarta"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_font_serif"
                        style="@style/Widget.AutoLyrics.Chip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/fraunces_semibold"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Serif"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_font_mono"
                        style="@style/Widget.AutoLyrics.Chip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/jetbrains_mono_medium"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Mono"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_font_cursive"
                        style="@style/Widget.AutoLyrics.Chip"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_extrabold"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Rounded"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AutoLyricsRowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Translate to English" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_translation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AutoLyricsRowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show pronunciation" />

                        <TextView
                            style="@style/AutoLyricsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Latin letters under Korean and Japanese lyrics. Japanese kanji stay as written." />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_romanization"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AutoLyricsRowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use Musixmatch" />

                        <TextView
                            style="@style/AutoLyricsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Look up lyrics on Musixmatch too. Often has word timing for karaoke." />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_musixmatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Phone timing -->
                <LinearLayout
                    android:id="@+id/layout_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AutoLyricsSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Timing on this phone" />

                    <TextView
                        style="@style/AutoLyricsHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Lyrics early or late? Tap Sync, then tap again each time the line shown starts." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_delay_minus"
                            style="@style/Widget.AutoLyrics.Chip.Square"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="Show lyrics 0.1 seconds earlier"
                            android:text="−" />

                        <TextView
                            android:id="@+id/tv_delay"
                            style="@style/AutoLyricsValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0 ms" />

                        <Button
                            android:id="@+id/btn_delay_plus"
                            style="@style/Widget.AutoLyrics.Chip.Square"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="Show lyrics 0.1 seconds later"
                            android:text="+" />

                        <Button
                            android:id="@+id/btn_delay_reset"
                            style="@style/Widget.AutoLyrics.Chip.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:text="Reset" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_quick_minus_1s"
                            style="@style/Widget.AutoLyrics.Chip.Quiet"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:text="−1 s"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btn_quick_minus_half"
                            style="@style/Widget.AutoLyrics.Chip.Quiet"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:text="−0.5 s"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btn_quick_plus_half"
                            style="@style/Widget.AutoLyrics.Chip.Quiet"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:text="+0.5 s"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btn_quick_plus_1s"
                            style="@style/Widget.AutoLyrics.Chip.Quiet"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:text="+1 s"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_tap_sync"
                        style="@style/Widget.AutoLyrics.Chip"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="Sync" />

                    <TextView
                        android:id="@+id/tv_sync_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_medium"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:paddingTop="10dp"
                        android:textColor="@color/headlight"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Android Auto -->
                <TextView
                    style="@style/AutoLyricsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Car screen" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AutoLyricsRowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Highlight each word" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_aa_karaoke"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AutoLyricsRowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Timing" />

                    <Button
                        android:id="@+id/btn_aa_delay_minus"
                        style="@style/Widget.AutoLyrics.Chip.Square"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Show car lyrics 0.1 seconds earlier"
                        android:text="−" />

                    <TextView
                        android:id="@+id/tv_aa_delay"
                        style="@style/AutoLyricsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:text="0 ms" />

                    <Button
                        android:id="@+id/btn_aa_delay_plus"
                        style="@style/Widget.AutoLyrics.Chip.Square"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Show car lyrics 0.1 seconds later"
                        android:text="+" />

                    <Button
                        android:id="@+id/btn_aa_delay_reset"
                        style="@style/Widget.AutoLyrics.Chip.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="Reset" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AutoLyricsRowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hide playback controls" />

                        <TextView
                            style="@style/AutoLyricsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Leaves more room for lyrics on the car's player and media card." />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_aa_hide_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
